# APK release binaries - large, versioned, copied straight to the server
# (never committed) - only latest.json (small metadata) may be tracked.
server/public/uploads/app-releases/*.apk

# User uploads (receipts, menu photos, branch logos) are client data, not source.
# Only the default "All Branches" logo is part of the app.
server/public/uploads/expense-receipts/
server/public/uploads/receipt-scan-history/
server/public/uploads/menu/
server/public/uploads/branches/*
