# Hours between automatic full user/fingerprint syncs, so changes made at the device show up. 0 = off.
ZK_RESYNC_HOURS=12
# Days to keep finished device commands (zk_device_commands). 0 = keep them.
ZK_COMMAND_LOG_DAYS=30
