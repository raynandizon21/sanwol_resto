# Copy this file to .env and adjust if needed.
# Local development environment (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sanwol_resto
DB_CONNECTION_LIMIT=20

# Node API
PORT=2300
NODE_ENV=development

# Python analytics server
PYSERVER_PORT=2400
PYSERVER_STARTUP_PING=false

# Secrets (local only — generate real random values for any shared/production environment)
SESSION_SECRET=local_dev_session_secret
JWT_SECRET=local_dev_jwt_secret
JWT_REFRESH_SECRET=local_dev_jwt_refresh_secret

# Optional integrations (safe to leave disabled locally)
TELEGRAM_POLLING_ENABLED=false
# Telegram "업장별 비교" button opens this HTTPS page; leave empty to hide the button.
BRANCH_COMPARE_PUBLIC_URL=
# Signs the Telegram Mini App login link; set a long random value in production.
TELEGRAM_MINIAPP_SECRET=
# Optional: comma-separated branch IDs whose dashboard/report caches are warmed on boot (e.g. 14).
CACHE_WARM_BRANCH_IDS=

# ZKTeco MB160 attendance device (see docs/zkteco-mb160.md). Its data is in the main DB above (zk_* tables).
# Port the device pushes to (MB160: COMM. > Cloud Server Setting > Server Port). Empty = listener off.
ZK_ADMS_PORT=2500
# Device clock offset from UTC in hours; sent to the device as TimeZone= and used for NOW() in device queries (config/zktecoDb.js).
ZK_TZ_OFFSET_HOURS=8
# Comma-separated device serial numbers allowed to push (Sanwol's MB160: ECV3262300063). A new device is
# registered only when it is listed. Empty = only devices registered before are accepted.
ZK_ALLOWED_SERIALS=
# Optional comma-separated source IPs allowed to reach the device port (e.g. the restaurant's static public IP).
# Empty = any IP.
ZK_ALLOWED_IPS=
# Proxies whose X-Forwarded-For is trusted for the client IP (Express "trust proxy"). Empty = loopback only
# (nginx/Caddy on the same server). Don't set "true" when the port is exposed directly.
ZK_TRUST_PROXY=
# sanwol_resto branches.IDNo assigned to a device the first time it connects. Empty = unassigned.
ZK_DEFAULT_BRANCH_ID=
<<<<<<< Updated upstream
